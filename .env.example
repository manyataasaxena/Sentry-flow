# Copy this file to .env and adjust values for your environment.

# Application
ENVIRONMENT=development
AUTH_DISABLED=true
JWT_SECRET=replace-this-development-secret
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Services (host-side defaults for Docker Compose)
POSTGRES_DSN=postgresql://sentryflow:sentryflow@localhost:5433/sentryflow
REDIS_URL=redis://localhost:6379/0
PG_POOL_MAX=20

# LLM
MOCK_LLM=true
MOCK_NODE_DELAY_MS=400
PRIMARY_LLM=openai:gpt-4o-mini
FALLBACK_LLM=anthropic:claude-haiku-4-5-20251001
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Guardrails and budgets
INTENT_MIN_CONFIDENCE=0.55
MAX_TOKENS_PER_RUN=20000
MAX_COST_USD_PER_RUN=0.50
RUN_TIMEOUT_SECONDS=120
HTTP_FETCH_ALLOWLIST=example.com,wikipedia.org,github.com
CHAOS_ENABLED=true
SHUTDOWN_GRACE_SECONDS=20

# Vite build-time browser API URL
VITE_API_URL=http://127.0.0.1:8000/api/v1
