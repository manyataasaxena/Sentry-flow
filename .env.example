# --- App ---
ENVIRONMENT=development
AUTH_DISABLED=true
JWT_SECRET=change-me-to-a-secure-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Data ---
POSTGRES_DSN=postgresql://sentryflow:sentryflow@localhost:5432/sentryflow
REDIS_URL=redis://localhost:6379/0
PG_POOL_MAX=20

# --- LLM ---
MOCK_LLM=true
PRIMARY_LLM=openai:gpt-4o-mini
FALLBACK_LLM=anthropic:claude-haiku-4-5-20251001
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Guardrails & budgets ---
INTENT_MIN_CONFIDENCE=0.55
MAX_TOKENS_PER_RUN=20000
MAX_COST_USD_PER_RUN=0.50
RUN_TIMEOUT_SECONDS=120
HTTP_FETCH_ALLOWLIST=example.com,wikipedia.org
CHAOS_ENABLED=true
